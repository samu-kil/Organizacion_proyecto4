// No debe existir Grafico.jack. No se permite llamar a Memory.poke,
// Memory.peek ni Math.multiply.

// dibujarCelda(fila, col, sprite)
// argument 0 = fila (0..15)
// argument 1 = col (0..31)
// argument 2 = direccion del Array de 16 palabras del sprite.
//
// Linea k de la celda:
// RAM[16384 + fila*512 + k*32 + col] = sprite[k].

function Grafico.dibujarCelda 3

// local 0 = contador de lineas (16)
// local 1 = contador temporal para calcular la fila
// local 2 = reservado

// Inicializar destino en la direccion base de pantalla.
push constant 16384
pop pointer 1

// Calcular fila * 512 mediante sumas repetidas.
push argument 0
pop local 1

label CALCULAR_FILA
push local 1
push constant 0
eq
if-goto FIN_FILA

push pointer 1
push constant 512
add
pop pointer 1

push local 1
push constant 1
sub
pop local 1

goto CALCULAR_FILA

label FIN_FILA

// Sumar la columna.
push pointer 1
push argument 1
add
pop pointer 1

// Inicializar direccion del sprite.
push argument 2
pop pointer 0

// Copiar las 16 lineas.
push constant 16
pop local 0

label COPIAR_LINEA

// Leer palabra del sprite.
push pointer 0
pop that

push that 0

// Direccion de destino.
push pointer 1
pop that

// Escribir en pantalla.
pop that 0

// Avanzar uno en el sprite.
push pointer 0
push constant 1
add
pop pointer 0

// Avanzar 32
push pointer 1
push constant 32
add
pop pointer 1

// Reducir contador.
push local 0
push constant 1
sub
pop local 0

// Repetir hasta copiar las 16 lineas.
push local 0
push constant 0
gt
if-goto COPIAR_LINEA

// Funcion void: retornar 0.
push constant 0
return