/*********
* Carrera.jack - Logica del juego de carriles (seccion 8 del enunciado).
* No puede usar Screen, Output, Keyboard, Grafico ni Sys.wait, ni
* directamente ni a traves de las clases que use.
* Autor 1:
* Autor 2:
* Autor 3:
*********/
class Carrera {
 field Array obs;
    field int n, carroCarril, pedido, vidas, puntaje, progreso, estado, meta, x;

    /** Nueva carrera: carro en el carril 1, 3 vidas, puntaje 0, progreso 0,
        estado 0 y sin obstaculos. semilla inicializa el generador. */
    constructor Carrera new(int pasosMeta, int semilla) {
        let obs = Array.new(20);
        let n = 0;
        let carroCarril = 1;
        let pedido = 0;
        let vidas = 3;
        let puntaje = 0;
        let progreso = 0;
        let estado = 0;
        let meta = pasosMeta;
        let x = semilla;
        return this;
    }

    /** Libera los obstaculos, los objetos internos y la carrera. */
    method void dispose() {
    var int i;
    var Obstaculo o;
        let i = 0;
        while (i < n) {
        let o = obs[i];
        do o.dispose();
        let i = i + 1; 
        }
    do obs.dispose();
    do Memory.deAlloc(this);
        return;
    }

    /** Solicita un cambio de carril: -1 sube, 1 baja (seccion 8.3). */
    method void moverCarro(int dir) {
    if ((estado = 0) & ((dir = -1) | (dir = 1))) {
    let pedido = dir;
    }
    return;
    }

    /** Agrega un obstaculo del tipo dado con su celda izquierda en col. */
    method void agregarObstaculo(int tipo, int carril, int col) {
    var Obstaculo o;
    if (~(n < 20)) { return; }
    if ((tipo < 0) | (tipo > 3)) { return; }
    if ((carril < 0) | (carril > 2)) { return; }
    if ((col < 0) | (col > 31)) { return; }
    let o = Obstaculo.new(tipo, carril, col);
    let obs[n] = o;
    let n = n + 1;
    return;
    }
method void quitar(int i) {
        var Obstaculo o;
        let o = obs[i];
        do o.dispose();
        let n = n - 1;
        let obs[i] = obs[n];
        return;
    }

    /** Paso 1: aplica el cambio de carril pedido si queda entre 0 y 2. */
    method void aplicarCambio() {
        var int nuevo;
        if (pedido = 0) { return; }
        let nuevo = carroCarril + pedido;
        if (~(nuevo < 0) & ~(nuevo > 2)) {
        let carroCarril = nuevo;
        }
        let pedido = 0;
        return;
    }

    /** Paso 3: choques con el carro (columna 2); elimina lo que choca. */
    method void procesarChoques() {
        var int i;
        var Obstaculo o;
        let i = 0;
        while (i < n) {
        let o = obs[i];
        if ((o.getCarril() = carroCarril) & o.tocaCarro(2)) {
        if (o.esLetal()) {
        if (vidas > 0) { let vidas = vidas - 1; }
        } else {
        let puntaje = puntaje + o.puntos();
         }
        do quitar(i);
        } else {
        let i = i + 1;
        }
        }
        return;
    }

    /** Paso 4: elimina los obstaculos que salieron por la izquierda. */
    method void eliminarSalidos() {
        var int i;
        var Obstaculo o;
        let i = 0;
        while (i < n) {
         let o = obs[i];
         if (o.salio()) {
         do quitar(i);
         } else {
        let i = i + 1;
            }
        }
        return;
    }
    /** Un paso del juego, en el orden de la seccion 8.3. */
    method void avanzar() {
    var int i;
    var Obstaculo o;
        if (~(estado = 0)) { return; }
        do aplicarCambio();
        let i = 0;
        while (i < n) {
        let o = obs[i];
        do o.mover();
        let i = i + 1;
        }
        do procesarChoques();
        if (vidas = 0) {
        let estado = 1;
        return;
        }
        do eliminarSalidos();
        let progreso = progreso + 1;
        let puntaje = puntaje + 1;
        if (progreso = meta) { let estado = 2; }
        return;
    }
    /** Siguiente numero pseudoaleatorio entre 0 y m - 1 (x = 5x + 3). */
    method int aleatorio(int m) {
        var int v;
        let x = (x * 5) + 3;
        let v = (x & 32767) / 128;
        return v - ((v / m) * m);
    }

    /** siguiente carril al c, dando la vuelta: 0, 1, 2, 0... */
    method int siguienteCarril(int c) {
        if (c = 2) { return 0; }
        return c + 1;
    }

    /** verdaderosi el carril c tiene un obstaculo letal en columnas 26 a 31. */
    method boolean hayLetalCerca(int c) {
        var int i;
        var Obstaculo o;
        let i = 0;
        while (i < n) {
        let o = obs[i];
        if ((o.getCarril() = c) & o.esLetal() & o.enRango(26, 31)) {
        return true;
            }
        let i = i + 1;
        }
        return false;
    }
    /** Agrega a lo sumo un obstaculo en la columna 31 (seccion 8.4). */
    method void generar() {
        var int tipo, lane, otro1, otro2;
        if (~(estado = 0)) { return; }
        if (~(aleatorio(5) < 2)) { return; }
        let tipo = aleatorio(4);
        let lane = aleatorio(3);
        if (~(ocupada(lane, 31) = -1)) { return; }
        if (~(tipo = 3)) {
        let otro1 = siguienteCarril(lane);
        let otro2 = siguienteCarril(otro1);
        if (hayLetalCerca(otro1) & hayLetalCerca(otro2)) { return; }
        }
        do agregarObstaculo(tipo, lane, 31);
        return;
    }

    /** Carril del carro: 0, 1 o 2. */
    method int carrilCarro() {

        return carroCarril;
    }

    /** Tipo del obstaculo que ocupa (carril, col), o -1 si esta libre. */
    method int ocupada(int carril, int col) {
    var int i;
        var Obstaculo o;
        if ((col < 0) | (col > 31)) { return -1; }
        let i = 0;
        while (i < n) {
        let o = obs[i];
        if ((o.getCarril() = carril) & o.ocupa(col)) {
        return o.getTipo();
        }
        let i = i + 1;
        }
        return -1;
    }

    method int vidas() {
    
        return vidas;
    }

    method int puntaje() {
        
        return puntaje;
    }

    method int progreso() {
        
        return progreso;
    }

    /** 0 jugando, 1 derrota, 2 victoria. */
    method int estado() {
    
        return estado;
    }

    /** Cantidad de obstaculos activos. */
    method int cantidad() {
    
        return n;
    }
}

