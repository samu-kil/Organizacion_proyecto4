/*********
* Main.jack - Punto de entrada del juego. Solo crea el juego, lo ejecuta y
* lo libera.
* Autor 1:
* Autor 2:
* Autor 3:
*********/
class Main {

    /** Crea el juego, lo ejecuta y lo libera. */
    function void main() {
        var Juego juego;
        let juego = Juego.new();
        do juego.ejecutar();
        do juego.dispose();
        return;
    }
}
