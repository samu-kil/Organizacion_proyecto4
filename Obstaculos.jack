class Obstaculos {
field int tipo, carril, col, colAnterior, largo, velocidad;

/** construye un obstaculo */

let tipo = unTipo;
let carril = unCarril;
let colAnterior = unaCol;
let largo = 1;
let velocidad = 1;
if (unTipo = 1) { let largo = 3; }
if (unTipo = 2) { let velocidad = 2; }
return this;
}
/** se guarda la columna anterior y avanza hacia la izquierda */
 method void mover() {
        let colAnterior = col;
        let col = col - velocidad;
        return;

 }
 /** verdadero si sale completo a la izquierda */
 method boolean salio() {
        return ((col + largo) - 1) < 0;
/** verdadero si el obstaculo ocupa el carril C */
 method boolean ocupa(int c) {
        return ~(c < col) & ~(c > ((col + largo) - 1));
    }

    method boolean esLetal() { return ~(tipo = 3); }

    method int puntos() {
        if (tipo = 3) { return 10; }
        return 0;
    }

    method int getTipo() { return tipo; }
    method int getCarril() { return carril; }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
    method boolean enRango(int desde, int hasta) {
    return ~(col > hasta) & ~(((col + largo) - 1) < desde);
    }
}